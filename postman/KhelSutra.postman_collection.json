              "raw": "{\n  \"first_name\": \"Aarav\",\n  \"last_name\": \"Patel\",\n  \"date_of_birth\": \"2007-08-12\",\n  \"gender\": \"male\",\n  \"primary_sport_id\": 1\n}"
