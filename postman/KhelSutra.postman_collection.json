          }
        },
        {
          "name": "Delete Athlete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Organization-ID", "value": "{{organization_id}}" }
            ],
            "url": {
              "raw": "{{base_url}}/athletes/1",
              "host": ["{{base_url}}"],
              "path": ["athletes", "1"]
            }
          }
        }
      ]
    },
