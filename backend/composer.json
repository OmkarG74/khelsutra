{
    "name": "khelsutra/sports-management",
    "type": "project",
    "description": "KhelSutra Multi-Tenant Sports Management Software (Sports ERP)",
    "keywords": ["sports-management", "multi-tenancy", "laravel", "erp", "khelsutra"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "illuminate/database": "^13.32",
        "illuminate/events": "^13.32",
        "illuminate/translation": "^13.32",
        "illuminate/validation": "^13.32",
        "phpoption/phpoption": "^1.10",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/ApiResponse.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
